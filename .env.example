# 1) @BotFather -> /newbot -> bergan TOKENni shu yerga qo'ying
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2) O'zingizning Telegram ID raqamingiz (@userinfobot dan oling).
#    Bir nechta admin bo'lsa vergul bilan: 111111111,222222222
ADMIN_IDS=111111111

# 3) To'lov qabul qilinadigan karta
PAYMENT_CARD=8600 0000 0000 0000
PAYMENT_OWNER=ISM FAMILIYA

# 4) Foydalanuvchilar savol bilan murojaat qiladigan akkaunt
ADMIN_CONTACT=@b8_pubgm

# 5) (ixtiyoriy) Majburiy obuna kanallari. Bot shu kanallarda ADMIN bo'lishi shart.
#    Misol: REQUIRED_CHANNELS=@kanal1,@kanal2
REQUIRED_CHANNELS=@B8pubgm,@b8mini,

# (ixtiyoriy) Ma'lumotlar fayli joyi. Serverda doimiy papka ko'rsating.
# DB_FILE=/var/data/pubg-bot.json
